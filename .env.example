# Copy to .env and adjust. All values are optional.

# Port the server listens on.
PORT=3000

# Set this to a long random string to enable GET /api/orders.
# Without it, the admin endpoint stays disabled (returns 503).
# Generate one with: node -e "console.log(crypto.randomUUID())"
ADMIN_TOKEN=

# Where the SQLite file lives. Defaults to ./data
# DATA_DIR=/var/lib/sato-garage

# Number of reverse proxies in front of the app (Express "trust proxy").
# 1 is right for Render/Fly/Heroku/nginx. Use 0 if nothing is in front.
TRUST_PROXY=1

# Enables static asset caching.
# NODE_ENV=production
